    <string name="setting_desired_retention_item">Desired Retention (FSRS-7)</string>
    <string name="setting_desired_retention_value">%1$d% chance to remember when a card is due</string>
    <string name="setting_desired_retention_description">The probability of recalling a card that FSRS-7 aims for when scheduling reviews. Higher values mean shorter intervals and more reviews per day. 90% is a good default.</string>
    <string name="setting_desired_retention_low_warning">Below 85% intervals can become extremely long, especially with the default parameters.</string>
    <string name="setting_desired_retention_high_warning">Above 97% intervals become very short and the number of reviews grows quickly.</string>
    <string name="setting_fsrs_parameters_item">FSRS-7 Parameters</string>
    <string name="setting_fsrs_parameters_default">Default parameters</string>
    <string name="setting_fsrs_parameters_custom">Custom parameters</string>
    <string name="setting_fsrs_parameters_description">The 34 FSRS-7 model weights. Optimize fits them to your own review history, which usually makes scheduling more accurate once you have a few hundred reviews.</string>
    <string name="setting_fsrs_parameters_invalid">Enter exactly %1$d comma separated numbers</string>
    <string name="setting_fsrs_parameters_optimize">Optimize</string>
    <string name="setting_fsrs_parameters_reset">Reset to default</string>
    <string name="setting_fsrs_parameters_optimizing">Optimizing on your review history...</string>
    <string name="setting_fsrs_parameters_not_enough_data">Not enough reviews to optimize: %1$d of %2$d needed.</string>
    <string name="setting_fsrs_parameters_optimized">Optimized parameters fit your reviews better. Press Save to use them.</string>
    <string name="setting_fsrs_parameters_not_improved">Your current parameters already fit your reviews better, so they were kept.</string>
    <string name="setting_fsrs_parameters_metrics">Reviews: %1$d\nLog loss: %2$s → %3$s\nRMSE (bins): %4$s% → %5$s%</string>
    <string name="setting_fsrs_parameters_reschedule">Reschedule cards (recalculate due dates)</string>
    <string name="setting_fsrs_parameters_save">Save</string>
    <string name="setting_fsrs_parameters_applying">Recalculating memory states...</string>
    <string name="setting_fsrs_learning_steps_item">Learning Steps</string>
    <string name="setting_fsrs_relearning_steps_item">Relearning Steps</string>
    <string name="setting_fsrs_steps_none">None, FSRS-7 schedules same-day reviews</string>
    <string name="setting_fsrs_steps_description">Delays separated by spaces, like Anki: s, m, h or d (a number alone means minutes), e.g. 1m 10m. A card goes through these steps before FSRS-7 schedules it in days. Leave empty to let FSRS-7 schedule same-day reviews itself, which is recommended for FSRS-7.</string>
    <string name="setting_fsrs_steps_invalid">Use delays like 30s, 10m, 1h or 1d, separated by spaces</string>
    <string name="setting_learn_ahead_item">Learn Ahead Limit</string>
    <string name="setting_learn_ahead_value">%1$d minutes</string>
    <string name="setting_learn_ahead_description">Same as in Anki. When the only cards left are learning cards that are not due yet, the next one is shown early if it is due within this many minutes; otherwise the session ends and the card comes back once it is due. Due cards are always shown, this never skips any.</string>
    <string name="setting_fsrs_max_interval_item">Maximum Interval</string>
    <string name="setting_fsrs_max_interval_value">%1$d days</string>
    <string name="setting_fsrs_max_interval_description">The longest time between reviews, in days. Applies from the next review of each card.</string>
    <string name="setting_fsrs_max_interval_invalid">Enter a number of days between %1$d and %2$d</string>
    <string name="setting_pass_fail_item">Pass / Fail Buttons</string>
    <string name="setting_pass_fail_description">Only show Again and Good when grading reviews</string>

